FROM python:3.13-slim
WORKDIR /app
ENV XDG_CACHE_HOME=/tmp/yt-dlp
COPY . .
RUN python -m pip install --no-cache-dir '.[default,curl-cffi,rockcorp-api]'
USER 65532:65532
EXPOSE 8080
CMD ["python", "-m", "uvicorn", "yt_dlp.rockcorp_api:app_factory", "--factory", "--host", "0.0.0.0", "--port", "8080"]
